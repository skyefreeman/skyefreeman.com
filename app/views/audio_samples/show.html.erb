<% content_for :title, @audio_sample.title %>

<div class="page-content">
  <div class="page-content__header">
    <h1 class="page-content__title"><%= @audio_sample.title %></h1>
    <% if authenticated? %>
      <%= link_to "Edit", edit_audio_sample_path(@audio_sample), class: "page-content__action" %>
    <% end %>
  </div>

  <p class="audio-sample__description"><%= @audio_sample.description %></p>
  <%= render "player", audio_sample: @audio_sample %>
</div>
