<article class="audio-sample">
  <h2 class="audio-sample-list__title">
    <%= link_to audio_sample.title, audio_sample, class: "audio-sample-list__link" %>
  </h2>
  <p class="audio-sample-list__description">
    <%= audio_sample.description %>
  </p>
  <%= render "player", audio_sample: audio_sample %>
</article>
