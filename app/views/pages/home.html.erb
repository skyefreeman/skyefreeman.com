<div class="page-content">
  <ul class="post-list">
    <% @entries.each do |entry| %>
      <li class="post-list__item" id="home_<%= dom_id(entry) %>">
        <% if entry.is_a?(Post) %>
          <%= render "home_post", post: entry %>
        <% elsif entry.is_a?(Game) %>
          <%= render "home_game", game: entry %>
        <% elsif entry.is_a?(Link) %>
          <%= render entry, show_type: true %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
