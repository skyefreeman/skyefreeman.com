<%= form_with(model: game, id: "game-form", data: { controller: "game-upload", action: "submit->game-upload#submit", turbo: false }) do |form| %>
  <% if game.errors.any? %>
    <div class="form__errors">
      <h2><%= pluralize(game.errors.count, "error") %> prohibited this game from being saved:</h2>
      <ul>
        <% game.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form__group">
    <%= form.label :title, class: "form__label" %>
    <%= form.text_field :title, class: "form__input" %>
  </div>

  <div class="form__group">
    <%= form.label :url_slug, "URL Slug", class: "form__label" %>
    <%= form.text_field :url_slug, class: "form__input", placeholder: "space-shooter" %>
  </div>

  <div class="form__group">
    <%= form.label :description, class: "form__label" %>
    <%= form.text_area :description, class: "form__input", rows: 5 %>
  </div>

  <div class="form__group">
    <%= form.label :cover_image, class: "form__label" %>
    <%= form.file_field :cover_image, class: "form__input" %>
  </div>

  <% [[:linux_package, "Linux"], [:macos_package, "macOS"], [:windows_package, "Windows"]].each do |field, label| %>
    <div class="form__group">
      <%= form.label field, "#{label} Package (.zip)", class: "form__label" %>
      <div class="drop-zone" data-controller="drop-zone">
        <span data-drop-zone-target="label" class="drop-zone__label">Drop <%= label %> .zip here, or click to browse</span>
        <%= form.file_field field, class: "drop-zone__input", accept: ".zip", data: { "drop-zone-target": "input" } %>
      </div>
    </div>
  <% end %>

  <div class="form__group">
    <%= form.label :download_url_itch, "Download URL (itch.io)", class: "form__label" %>
    <%= form.text_field :download_url_itch, class: "form__input", placeholder: "https://username.itch.io/game" %>
  </div>
  <div class="game-upload" data-game-upload-target="feedback" hidden>
    <progress max="100" value="0" aria-label="Upload progress" data-game-upload-target="progress"></progress>
    <p role="status" data-game-upload-target="status"></p>
    <p role="alert" tabindex="-1" data-game-upload-target="error" hidden></p>
  </div>
<% end %>
