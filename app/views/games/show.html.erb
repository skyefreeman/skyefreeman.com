<% content_for :title, @game.title %>
<div class="page-content">

  <div class="page-content__header">
    <h1 class="page-content__title"><%= @game.title %></h1>
    <% if authenticated? %>
      <%= link_to "Edit Game", edit_game_path(@game), class: "page-content__action" %>
    <% end %>
  </div>

  <% if @game.cover_image.attached? %>
    <%= image_tag @game.cover_image, class: "game__cover-image" %>
  <% end %>

  <p class="game__date"><%= @game.created_at.strftime("%B %d, %Y") %></p>

  <% if @game.description.present? %>
    <p class="game__description"><%= @game.description %></p>
  <% end %>

  <% platform_packages = [
    (@game.linux_package.attached? ? link_to("Linux", rails_blob_path(@game.linux_package, disposition: "attachment"), class: "game__download-link") : nil),
    (@game.macos_package.attached? ? link_to("macOS", rails_blob_path(@game.macos_package, disposition: "attachment"), class: "game__download-link") : nil),
    (@game.windows_package.attached? ? link_to("Windows", rails_blob_path(@game.windows_package, disposition: "attachment"), class: "game__download-link") : nil)
  ].compact %>
  <% if platform_packages.any? %>
    <p class="game__downloads">Download it on <%= platform_packages.join(", ").html_safe %></p>
  <% end %>

  <% if @game.download_url_itch.present? %>
    <p class="game__downloads">Play it on <%= link_to "itch.io", @game.download_url_itch, class: "game__download-link" %></p>
  <% end %>

</div>
